<Project>
  <PropertyGroup>
    <UseLocalGameReferences Condition="'$(UseLocalGameReferences)' == ''">false</UseLocalGameReferences>
    <LocalGameDir Condition="'$(LocalGameDir)' == ''">$(BANNERLORD_GAME_DIR)</LocalGameDir>
    <DisableReferenceAssemblies Condition="'$(UseLocalGameReferences)' == 'true'">true</DisableReferenceAssemblies>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalGameReferences)' == 'true'">
    <!-- Compile against the installed game; never distribute its assemblies. -->
    <Reference Include="$(LocalGameDir)\bin\Win64_Shipping_Client\TaleWorlds.*.dll"
               Exclude="$(LocalGameDir)\bin\Win64_Shipping_Client\TaleWorlds.Native.dll;$(LocalGameDir)\bin\Win64_Shipping_Client\*.AutoGenerated*.dll;$(LocalGameDir)\bin\Win64_Shipping_Client\*Test*.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(LocalGameDir)\Modules\Native\bin\Win64_Shipping_Client\TaleWorlds.MountAndBlade.View.dll;$(LocalGameDir)\Modules\Native\bin\Win64_Shipping_Client\TaleWorlds.MountAndBlade.GauntletUI.dll;$(LocalGameDir)\Modules\SandBox\bin\Win64_Shipping_Client\SandBox*.dll;$(LocalGameDir)\Modules\StoryMode\bin\Win64_Shipping_Client\StoryMode.dll;$(LocalGameDir)\Modules\CustomBattle\bin\Win64_Shipping_Client\TaleWorlds.MountAndBlade.CustomBattle.dll;$(LocalGameDir)\Modules\Multiplayer\bin\Win64_Shipping_Client\TaleWorlds.MountAndBlade.Multiplayer.dll"
               Exclude="$(LocalGameDir)\Modules\SandBox\bin\Win64_Shipping_Client\*.AutoGenerated*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
